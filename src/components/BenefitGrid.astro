---
import { site } from '../content/site';
---

<section class="section section-alt" id="benefits" aria-labelledby="benefits-heading">
  <div class="container">
    <h2 id="benefits-heading">Why BenchHype</h2>
    <div class="benefit-grid">
      {site.benefits.map((benefit, i) => (
        <div class:list={['card', { 'card-featured': i === 0 }]}>
          <div class:list={['benefit-icon', { 'benefit-icon-accent': i === 0 }]}>
            <Fragment set:html={benefit.icon} />
          </div>
          <h3>{benefit.title}</h3>
          <p>{benefit.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 3rem;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--element-gap);
  }

  .card-featured {
    grid-column: 1 / -1;
    border-top: 2px solid var(--accent);
  }

  .card-featured h3 {
    font-size: var(--h2);
  }

  .card-featured p {
    max-width: 640px;
  }

  .benefit-icon {
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .benefit-icon-accent {
    color: var(--accent);
  }

  .benefit-grid h3 {
    margin-bottom: 0.75rem;
  }

  @media (max-width: 640px) {
    .benefit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
